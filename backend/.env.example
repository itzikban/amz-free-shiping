# Server
ADDR=:8085

# Decodo credentials (Base64 of user:password)
# Example generation:
# echo -n 'username:password' | base64
DECODO_BASIC_AUTH=

# Goscrape — direct Amazon scraper via Mullvad WireGuard tunnel
# Set to the WireGuard interface IP assigned by Mullvad (see README for setup)
GOSCRAPE_BIND_IP=
